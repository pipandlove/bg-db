{
  "name": "bg-db",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "bg-db",
      "version": "0.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@bg-db/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@bg-db/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@bg-db/cli",
      "version": "0.3.0",
      "license": "MIT",
      "dependencies": {
        "@bg-db/core": "0.3.0"
      },
      "bin": {
        "bgdb": "bin/bgdb.js"
      }
    },
    "packages/core": {
      "name": "@bg-db/core",
      "version": "0.3.0",
      "license": "MIT"
    }
  }
}
