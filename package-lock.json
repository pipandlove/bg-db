{
  "name": "bgdb",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "bgdb",
      "version": "0.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@bgdb/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@bgdb/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@bgdb/cli",
      "version": "0.3.0",
      "license": "MIT",
      "dependencies": {
        "@bgdb/core": "0.3.0"
      },
      "bin": {
        "bgdb": "bin/bgdb.js"
      }
    },
    "packages/core": {
      "name": "@bgdb/core",
      "version": "0.3.0",
      "license": "MIT"
    }
  }
}
